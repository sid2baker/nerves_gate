#!/bin/sh
# Firmware boot only, before Tailscale or LAN configuration starts.
# Do not turn the Ethernet/USB ports into an unrestricted IP router.
if printf '0\n' > /proc/sys/net/ipv4/ip_forward &&
   iptables -w 5 -P FORWARD DROP &&
   printf '1\n' > /proc/sys/net/ipv4/ip_forward; then
    exit 0
fi

# Keep local/USB recovery available if the target lacks routing support.
echo "nerves-gate: IPv4 subnet routing unavailable; check forwarding/netfilter support" >&2
exit 0
