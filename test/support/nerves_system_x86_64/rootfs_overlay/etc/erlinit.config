# EC100-aligned runtime on QEMU's serial console.
-c ttyS0
--warn-unused-tty
-s "/usr/bin/nbtty"
--update-clock
--shutdown-report /root/shutdown.txt
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Retain the x86 GRUB/MBR layout. /data is a symlink to /root, as on EC100.
-m /dev/rootdisk0p1:/boot/grub:vfat:ro,nodev,noexec,nosuid:
-m /dev/rootdisk0p4:/root:ext4:nodev:

-r /srv/erlang
-d /usr/bin/boardid
-n nerves-%-.4s
--boot shoehorn
