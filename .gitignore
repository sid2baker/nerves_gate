# The directory Mix will write compiled artifacts to.
**/_build/

# If you run "mix test --cover", coverage assets end up here.
**/cover/

# The directory Mix downloads your dependencies sources to.
**/deps/

# Where third-party dependencies like ExDoc output generated docs.
**/doc/

# Temporary files, for example, from tests.
/tmp/

# Local credentials, upload scripts and asset tooling.
.env
.env.*
/firmware/upload.sh
/firmware/priv/plugins/
/firmware/priv/plugins.*
/plugins/*/packages/
/plugins/*/tmp/
**/node_modules/

# Local Nerves system build artifacts and device backups.
**/.nerves/
**/build.log
/ec100-backups/
em300-backups/

# Tailscale binaries installed explicitly for each firmware architecture.
/firmware/rootfs_overlay/ec100/usr/sbin/tailscaled
/firmware/rootfs_overlay/em300/usr/sbin/tailscaled
/firmware/rootfs_overlay/x86_64/usr/sbin/tailscaled

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# ExUnit tmp_dir output in each project.
/*/tmp/
