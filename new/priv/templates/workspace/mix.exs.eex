<%= if source, do: "# Local platform development: use this checkout, not released packages.\nSystem.put_env(\"NERVES_GATE_LOCAL_DEPS\", \"1\")\n\n" %>defmodule <%= module %>.Workspace.MixProject do
  use Mix.Project

  def project do
    [
      app: :<%= name %>_workspace,
      version: "0.1.0",
      elixir: "~> 1.20",
<%= if source, do: "      nerves_gate_source: #{inspect(source)},\n" %>      deps: [
        {:nerves_gate_new, "~> 0.1", <%= if source, do: "path: #{inspect(Path.join(source, "new"))}, " %>only: [:dev, :test], runtime: false},
        {:nerves_gate_sim, "~> 0.1.0", <%= if source, do: "path: #{inspect(Path.join(source, "sim"))}, " %>only: [:dev, :test], runtime: false}
      ],
      aliases: [
        setup: ["deps.get", "qemu.setup", &workspace(:setup, &1)],
        sim: &workspace(:sim, &1),
        "app.new": &workspace(:new, &1),
        "app.install": &workspace(:install, &1),
        "app.console": &workspace(:console, &1),
        "app.package": &workspace(:package, &1),
        test: &workspace(:test, &1),
        format: ["format", &workspace(:format, &1)]
      ]
    ]
  end

  def application, do: []

  defp workspace(command, args) do
    Mix.Task.run("compile")
    apply(NervesGateNew.Workspace, command, [args])
  end
end
