From: EC100 Nerves maintainers
Subject: [PATCH] package/rockchip-rkbin: pin official RK3506 component set

Use the standard RK3506 loader/TOS set without a separately vendored DDR
binary. Use a checksummed GitHub archive so the source bytes are reproducible.

--- a/package/rockchip-rkbin/rockchip-rkbin.mk
+++ b/package/rockchip-rkbin/rockchip-rkbin.mk
@@ -4,9 +4,8 @@
 #
 ################################################################################
 
-ROCKCHIP_RKBIN_VERSION = f43a462e7a1429a9d407ae52b4745033034a6cf9
-ROCKCHIP_RKBIN_SITE = https://github.com/rockchip-linux/rkbin.git
-ROCKCHIP_RKBIN_SITE_METHOD = git
+ROCKCHIP_RKBIN_VERSION = 3e288fe814e059dd06833495f845cab04ac20a5c
+ROCKCHIP_RKBIN_SITE = $(call github,rockchip-linux,rkbin,$(ROCKCHIP_RKBIN_VERSION))
 ROCKCHIP_RKBIN_LICENSE = PROPRIETARY
 ROCKCHIP_RKBIN_LICENSE_FILES = LICENSE
 
--- a/package/rockchip-rkbin/rockchip-rkbin.hash
+++ b/package/rockchip-rkbin/rockchip-rkbin.hash
@@ -1,3 +1,3 @@
 # Locally computed
-sha256  4a70cdc877600b75c0a885a8ebe1aa68f0800a0010aa580c105cbd9386140fa7  rockchip-rkbin-f43a462e7a1429a9d407ae52b4745033034a6cf9-git4.tar.gz
-sha256  d2765124a2c24d71aba3cbc6cdd6975a5a297821264eb6c26378a4c16cd16e92  LICENSE
+sha256  db37f808d90033293e401b5db890aff37e2418a6af14bdfcd8e93ab98397edd8  rockchip-rkbin-3e288fe814e059dd06833495f845cab04ac20a5c.tar.gz
+sha256  1b3cfbd212ef0e645b34aa6beee07343ce954a4f512338f12317ab297a9c9829  LICENSE
