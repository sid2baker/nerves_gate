/dts-v1/;

/ {
    description = "Nerves EM300 RK3506 FIT";
    #address-cells = <1>;

    images {
        kernel {
            description = "Linux kernel";
            data = /incbin/("zImage");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            load = <0x02080000>;
            entry = <0x02080000>;
            hash-1 { algo = "sha256"; };
        };

        fdt {
            description = "IOTRouter EM300 RK3506 device tree";
            data = /incbin/("rk3506-em300.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            // This BSP requires a load address even for the FDT subimage.
            load = <0x06000000>;
            hash-1 { algo = "sha256"; };
        };
    };

    configurations {
        default = "conf";
        conf {
            description = "EM300 Nerves";
            kernel = "kernel";
            fdt = "fdt";
        };
    };
};
