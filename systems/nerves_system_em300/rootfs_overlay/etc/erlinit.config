# EM300 Nerves erlinit configuration
-c ttyS0
--warn-unused-tty
-s "/usr/bin/nbtty"
--update-clock
--shutdown-report /root/shutdown.txt
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Persistent application filesystem: UBIFS on UBI volume "data" (vol_id 2).
# UBIFS formats an empty volume on first mount. /data is a symlink to /root.
-m /dev/ubi0_2:/root:ubifs:nodev:

-r /srv/erlang
-n em300
--boot shoehorn
