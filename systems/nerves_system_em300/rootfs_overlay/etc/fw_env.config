# EM300 U-Boot redundant environment in the "env" SPI NAND partition (mtd2).
# U-Boot reads the same copies at NAND offsets 0x800000 and 0x820000.
# Device             Offset       Env size     Flash sector
/dev/mtdblock2        0x00000000   0x00020000   0x00020000
/dev/mtdblock2        0x00020000   0x00020000   0x00020000
