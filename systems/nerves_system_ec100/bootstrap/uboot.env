# Default U-Boot environment for EC100 Nerves A/B boot.
# Offsets are MMC sectors (512 bytes), hexadecimal.

bootlimit=3
nerves_fw_active=a
upgrade_available=0
bootcount=0

fit_a_sector=0x8000
fit_b_sector=0x18000
fit_blocks=0x10000
# FIT read buffer must not overlap its kernel's load/decompression region.
kernel_addr_r=0x08000000

# $name survives fwup archive creation AND application; ${name} does not.
boot_a=setenv rootpart 1; setenv fit_sector $fit_a_sector; run boot_slot
boot_b=setenv rootpart 2; setenv fit_sector $fit_b_sector; run boot_slot

boot_slot=if mmc dev 0 && mmc read $kernel_addr_r $fit_sector $fit_blocks; then setenv bootargs earlycon=uart8250,mmio32,0xff0a0000 console=ttyS0,115200 root=/dev/mmcblk0p$rootpart rootwait ro; bootm $kernel_addr_r#conf - $kernel_addr_r#conf; else echo Nerves FIT read failed; fi

rollback=if test "$upgrade_available" = "1"; then if test $bootcount -gt $bootlimit; then if test "$nerves_fw_active" = "a"; then setenv nerves_fw_active b; else setenv nerves_fw_active a; fi; setenv upgrade_available 0; setenv bootcount 0; saveenv; fi; fi

bootcmd=run rollback; if test "$nerves_fw_active" = "b"; then run boot_b; else run boot_a; fi
# U-Boot selects altbootcmd rather than bootcmd after bootlimit is exceeded.
altbootcmd=run bootcmd
