# Match EC100's platform-independent gateway kernel features.
# Keep x86/virtio drivers in linux-6.18.defconfig; do not emulate EC100 I/O.
# CONFIG_WERROR is not set
# CONFIG_MODULES is not set
CONFIG_STRICT_KERNEL_RWX=y

CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y

# VintageNet and Tailscale policy routing, for both address families.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# LAN bridge; keep ordinary Layer-2 traffic out of the IP firewall.
CONFIG_BRIDGE=y
# CONFIG_BRIDGE_NETFILTER is not set
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y

# Tailscale's default iptables backend: dual-stack filtering, NAT and marks.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
# Linux 6.17+ gates the legacy tables separately. Enable these before Kconfig
# resolves NAT; Buildroot's later iptables fixups do not restore dropped NAT.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y

# Same headless, wired profile as EC100. QEMU has no EC100 GPIO watchdog.
# CONFIG_SOFT_WATCHDOG is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
