# EC100-aligned runtime on QEMU's serial console.
-c ttyS0
--warn-unused-tty
-s "/usr/bin/nbtty"
--update-clock
--shutdown-report /root/shutdown.txt
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Retain the x86 GRUB/MBR layout. /data is a symlink to /root, as on EC100.
-m /dev/rootdisk0p1:/boot/grub:vfat:ro,nodev,noexec,nosuid:
-m /dev/rootdisk0p4:/root:ext4:nodev:

-r /srv/erlang
# boardid reads the disk's provisioned serial (qemu-N). VintageNetDirect uses
# this hostname for its normal per-device recovery subnet, just as on hardware.
-d /usr/bin/boardid
-n %s

# The bench's fourth virtio NIC is the direct provisioning connection. Built-in
# drivers expose it down at boot; name it like EC100's gadget before Erlang runs.
--pre-run-exec "/sbin/ip link set eth3 name usb0"
--boot shoehorn
